# .env.example — copy to .env (preview) or .env.production (MTB IIS build)

# MTB REST API base. Required in production.
VITE_API_BASE=https://api.mtb.example/ambala/api/v1

# "true" only for the Lovable preview / local dev: routes calls to the mock adapter (OTP 123456).
VITE_USE_MOCK=true

# Allow capture without the blink check if the face model can't load.
VITE_ALLOW_LIVENESS_FALLBACK=true

# Sent as the X-App-Version header on every request.
VITE_APP_VERSION=1.0.0
